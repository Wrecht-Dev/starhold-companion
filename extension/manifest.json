{
  "manifest_version": 3,
  "name": "Starhold Companion Bridge",
  "version": "0.1.0",
  "description": "Connects the Starhold web app to the local companion player. No tracking, no access outside Starhold origins.",
  "permissions": ["nativeMessaging"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://beta.mithraic.cloud/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://beta.mithraic.cloud/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": { "service_worker": "background.js" }
}
